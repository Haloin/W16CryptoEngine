FROM debian:bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config \
    libnats-dev nlohmann-json3-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY . .

RUN cmake -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build --parallel $(nproc) && \
    strip build/predmarket-engine

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libnats0 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -r -s /bin/false predmarket && \
    mkdir -p /var/lib/predmarket/wal && \
    chown predmarket:predmarket /var/lib/predmarket/wal

COPY --from=builder /build/build/predmarket-engine /usr/local/bin/predmarket-engine

USER predmarket

ENTRYPOINT ["predmarket-engine"]
