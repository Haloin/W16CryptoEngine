# =============================================================================
# PolyMarket Core Engine - Production Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/predmarket
DATABASE_MAX_CONNECTIONS=100
DATABASE_MIN_CONNECTIONS=10
DATABASE_CONNECT_TIMEOUT=10
DATABASE_IDLE_TIMEOUT=300
DATABASE_MAX_LIFETIME=1800

# -----------------------------------------------------------------------------
# Redis Configuration (for caching and pub/sub)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=50
REDIS_TIMEOUT=5

# -----------------------------------------------------------------------------
# Kafka Configuration (for event streaming)
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_MARKET_DATA=market_data
KAFKA_TOPIC_ORDERS=orders
KAFKA_TOPIC_FILLS=fills
KAFKA_CONSUMER_GROUP=predmarket-engine
KAFKA_PRODUCE_ACKS=all
KAFKA_BATCH_SIZE=16384
KAFKA_LINGER_MS=5

# -----------------------------------------------------------------------------
# HFT Engine Configuration
# -----------------------------------------------------------------------------
HFT_ENGINE_ENABLED=true
HFT_MARKET_DATA_CORE=1
HFT_STRATEGY_CORE=2
HFT_EXECUTION_CORE=3
HFT_LATENCY_THRESHOLD_NS=500000
HFT_ORDER_QUEUE_SIZE=1024
HFT_SIGNAL_QUEUE_SIZE=1024
HFT_MARKET_DATA_QUEUE_SIZE=1024

# -----------------------------------------------------------------------------
# Polymarket API Configuration
# -----------------------------------------------------------------------------
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://clob.polymarket.com/ws
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_CHAIN_ID=137

# -----------------------------------------------------------------------------
# Web3 Configuration
# -----------------------------------------------------------------------------
RPC_URL=https://polygon-rpc.com
WS_RPC_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=
CHAIN_ID=137
CONTRACT_ADDRESS=0x4bFb41d5B3570DeFd03C39a9A4D8dEEDBdC96028

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=8
REQUEST_TIMEOUT_SECS=30
KEEP_ALIVE_SECS=60
MAX_REQUEST_SIZE_MB=10

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
CORS_ALLOWED_ORIGINS=https://app.predmarket.com,https://admin.predmarket.com
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST_SIZE=150

# -----------------------------------------------------------------------------
# Observability Configuration
# -----------------------------------------------------------------------------
RUST_LOG=info
RUST_BACKTRACE=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=predmarket-api
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_ANALYTICS=true
ENABLE_ML_PREDICTION=true
ENABLE_ARBITRAGE_DETECTION=true
ENABLE_RISK_CHECKS=true
ENABLE_AUDIT_LOGGING=true

# -----------------------------------------------------------------------------
# HFT Advanced Configuration
# -----------------------------------------------------------------------------
USE_IO_URING=true
USE_KERNEL_BYPASS=false
USE_SIMDJSON=true
USE_LIBSECP256K1=true
LOCK_MEMORY=true
REALTIME_SCHEDULING=true

# -----------------------------------------------------------------------------
# Circuit Breaker Configuration
# -----------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECS=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3

# -----------------------------------------------------------------------------
# Snapshot Configuration
# -----------------------------------------------------------------------------
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL_SECS=300
SNAPSHOT_DIR=/var/lib/predmarket/snapshots
SNAPSHOT_MAX_AGE_DAYS=7

# -----------------------------------------------------------------------------
# Alerting Configuration
# -----------------------------------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK=
ALERT_PAGERDUTY_KEY=
ALERT_LATENCY_THRESHOLD_MS=10
ALERT_ERROR_RATE_THRESHOLD=0.01
