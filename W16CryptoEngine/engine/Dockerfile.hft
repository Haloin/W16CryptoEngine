FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    clang-15 \
    llvm-15 \
    git \
    wget \
    python3 \
    python3-pip \
    libnuma-dev \
    linux-headers-generic \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/cc cc /usr/bin/clang-15 100 && \
    update-alternatives --install /usr/bin/c++ c++ /usr/bin/clang++-15 100

WORKDIR /deps

RUN git clone --depth 1 https://github.com/simdjson/simdjson.git && \
    cd simdjson && \
    cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DSIMDJSON_DEVELOPER_MODE=OFF && \
    cmake --build build --target install -j$(nproc)

RUN git clone --depth 1 https://github.com/bitcoin-core/secp256k1.git && \
    cd secp256k1 && \
    cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DSECP256K1_ENABLE_MODULE_RECOVERY=ON \
        -DSECP256K1_ENABLE_MODULE_ECDH=ON && \
    cmake --build build --target install -j$(nproc)

RUN apt-get update && apt-get install -y liburing-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY . .

RUN cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=clang-15 \
    -DCMAKE_CXX_COMPILER=clang++-15 \
    -DUSE_IO_URING=ON \
    -DUSE_SIMDJSON=ON \
    -DUSE_SECP256K1=ON \
    -DUSE_NUMA=ON \
    -DUSE_HUGEPAGES=ON \
    -GNinja

RUN cmake --build build --target predmarket-hft -j$(nproc)

FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    libnuma1 \
    liburing2 \
    && rm -rf /var/lib/apt/lists/*

RUN echo "@hft soft rtprio 99" >> /etc/security/limits.conf && \
    echo "@hft hard rtprio 99" >> /etc/security/limits.conf && \
    echo "@hft soft memlock unlimited" >> /etc/security/limits.conf && \
    echo "@hft hard memlock unlimited" >> /etc/security/limits.conf

RUN useradd -m -s /bin/bash hft && usermod -aG hft hft

WORKDIR /app

COPY --from=builder /build/build/bin/predmarket-hft /app/

RUN chown -R hft:hft /app

USER hft

ENTRYPOINT ["./predmarket-hft"]
